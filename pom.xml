<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.yourname</groupId>
    <artifactId>mc-loadtest</artifactId>
    <version>2.0.0</version>
    <packaging>jar</packaging>

    <name>MC LoadTest Bot</name>
    <description>A stress test tool for Minecraft servers with random bots and attack support</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!-- 只使用 OpenCollab 仓库（包含所有稳定版本） -->
    <repositories>
        <repository>
            <id>opencollab-releases</id>
            <url>https://repo.opencollab.dev/maven-releases/</url>
        </repository>
        <!-- 如果以后需要快照版本，可取消下面注释 -->
        <!--
        <repository>
            <id>opencollab-snapshots</id>
            <url>https://repo.opencollab.dev/maven-snapshots/</url>
        </repository>
        -->
    </repositories>

    <dependencies>
        <!-- MCProtocolLib 的正确坐标（基于截图中的目录） -->
        <dependency>
            <groupId>com.github.steveice10</groupId>
            <artifactId>mcprotocollib</artifactId>
            <version>1.20.2-1</version>   <!-- 支持 Minecraft 1.20.2 -->
            <!-- 如需其他版本，可改为 1.20.4-1、1.19.4-1 等 -->
        </dependency>
        <!-- 其他依赖（如果有）可以在此添加 -->
    </dependencies>

    <build>
        <finalName>MCBot-LoadTest</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>LoadTestTool</mainClass>   <!-- 请确认你的主类名 -->
                        </manifest>
                    </archive>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                    <appendAssemblyId>false</appendAssemblyId>
                </configuration>
                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
